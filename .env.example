# Required
GROQ_API_KEY=your-groq-api-key

# Optional: LangSmith tracing (use LANGSMITH_*, not the older LANGCHAIN_* names)
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=your-langsmith-key
# LANGSMITH_PROJECT=minty-banking-assistant

# Optional: DEBUG shows retrieval/rerank order and validator output per request
# LOG_LEVEL=INFO

# Optional: Redis location (docker-compose sets REDIS_HOST=redis automatically)
# REDIS_HOST=localhost
# REDIS_PORT=6379

# Optional: behind a reverse proxy, the proxy's IP so uvicorn trusts
# X-Forwarded-For and rate limiting sees real client IPs
# FORWARDED_ALLOW_IPS=127.0.0.1
